# ---- Local testing ----
# 1 = store data in .data/local-db.json instead of Supabase (no Supabase needed). Remove/0 for production.
LOCAL_DB=0

# ---- Supabase (Project Settings > API) ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Service role key: server-side only. NEVER expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Admin login ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# Long random string used to sign session cookies (e.g. `openssl rand -hex 32`)
SESSION_SECRET=replace-with-a-long-random-string

# ---- Google Form shown on the home page ----
NEXT_PUBLIC_GOOGLE_FORM_URL=https://forms.gle/your-form-id
NEXT_PUBLIC_TICKET_PRICE=50

# ---- Public URL of the hosted app (used in emails) ----
APP_URL=http://localhost:3000

# ---- Central sender e-mail (SMTP) ----
# Gmail: enable 2FA and create an "App password" for SMTP_PASS.
MAIL_FROM=insightmotivated@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=insightmotivated@gmail.com
SMTP_PASS=your-app-password

# ---- Google Form -> auto e-mail webhook ----
# Shared secret (16+ chars) that the Google Apps Script sends in the x-webhook-secret header.
# Generate one with: openssl rand -hex 24
FORM_WEBHOOK_SECRET=replace-with-a-long-random-string

# ---- Google Form responses sheet (auto-email by polling; works on localhost) ----
# Share the sheet as "Anyone with the link: Viewer". ID is the part between /d/ and /edit in its URL.
# While the server runs it checks the sheet every SHEET_POLL_SECONDS (min 15) and e-mails new responses.
# Leave GOOGLE_SHEET_ID unset on serverless hosts (e.g. Vercel) and use the Apps Script webhook instead.
GOOGLE_SHEET_ID=1bz7n3zdcR3MYPVZFDQt6WfaBLfRIwnklwitNxnz0j04
# GOOGLE_SHEET_GID=0
SHEET_POLL_SECONDS=30
